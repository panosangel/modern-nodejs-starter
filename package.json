{
  "name": "modern-nodejs-starter",
  "version": "1.0.0",
  "description": "A starting point for modern Node.js projects with TypeScript support and more!",
  "license": "MIT",
  "author": "Panos Angel (https://angelidakis.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panosangel/modern-nodejs-starter.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/",
    "lint:fix": "eslint . --fix ",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.0"
  }
}
